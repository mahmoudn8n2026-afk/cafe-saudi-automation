{
  "name": "Saudi Youth Cafe - Content Production Workflow",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ]
      },
      "id": "node_telegram_trigger",
      "name": "Telegram Trigger (Photo + Caption)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [100, 300],
      "webhookId": "saudi-cafe-telegram-webhook",
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Saudi Cafe Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.photo ? 'has_photo' : ($json.callback_query ? 'callback' : 'other') }}",
              "value2": "has_photo"
            }
          ]
        }
      },
      "id": "node_router",
      "name": "Router (Photo or Callback)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "operation": "getFile",
        "fileId": "={{ $json.message.photo[$json.message.photo.length - 1].file_id }}"
      },
      "id": "node_download_photo",
      "name": "Download Telegram Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [540, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Saudi Cafe Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $node['Telegram Trigger (Photo + Caption)'].json.message.caption || '';\nlet style = 'مرِح';\nif (text.includes('استيتيك') || text.includes('أستيتيك') || text.includes('رايق')) style = 'أستيتيك';\nif (text.includes('ترند') || text.includes('تحدي') || text.includes('هبة')) style = 'ترند';\n\nconst jobId = 'job_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);\nconst chatId = $node['Telegram Trigger (Photo + Caption)'].json.message.chat.id;\n\nreturn {\n  job_id: jobId,\n  chat_id: chatId,\n  user_caption: text,\n  style: style,\n  status: 'received',\n  received_at: new Date().toISOString()\n};"
      },
      "id": "node_parse_input",
      "name": "Parse Caption & Style",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDEO_API_URL || 'http://127.0.0.1:8000' }}/api/jobs/process",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.job_id }}\",\n  \"image_paths\": [\"/tmp/telegram_photo_{{ $json.job_id }}.jpg\"],\n  \"user_caption\": \"{{ $json.user_caption }}\",\n  \"style\": \"{{ $json.style }}\",\n  \"telegram_chat_id\": \"{{ $json.chat_id }}\",\n  \"engine_mode\": \"free\"\n}"
      },
      "id": "node_video_engine",
      "name": "Generate Saudi Video (FFmpeg + EdgeTTS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [980, 200]
    },
    {
      "parameters": {
        "operation": "sendVideo",
        "chatId": "={{ $node['Parse Caption & Style'].json.chat_id }}",
        "file": "={{ $json.final_video_path }}",
        "caption": "=✨🎬 فيديو الكافيه جاهز يا بطل! (النمط: {{ $node['Parse Caption & Style'].json.style }})\n\n💡 جملة الهوك: {{ $json.script_data.hook_text }}\n\n📱 كابشن تيك توك وريلز:\n{{ $json.script_data.captions.tiktok }}\n\n🏷️ الهاشتاجات:\n{{ $json.script_data.hashtags.join(' ') }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": [
                {
                  "text": "موافقة ونشر ✅",
                  "additionalFields": {
                    "callback_data": "=approve_{{ $json.job_id }}"
                  }
                },
                {
                  "text": "إعادة التوليد 🔁",
                  "additionalFields": {
                    "callback_data": "=retry_{{ $json.job_id }}"
                  }
                }
              ]
            }
          ]
        }
      },
      "id": "node_send_telegram_approval",
      "name": "Send Video & Approval Buttons",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Saudi Cafe Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.callback_query.data.split('_')[0] }}",
              "value2": "approve"
            }
          ]
        }
      },
      "id": "node_handle_callback",
      "name": "Is Approve Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [540, 420]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.callback_query.message.chat.id }}",
        "text": "=🎉 تم اعتماد الفيديو بنجاح! تم حفظه وجدولته للنشر على حسابات الكافيه. كفو والله يا غالي! 🚀"
      },
      "id": "node_approve_msg",
      "name": "Send Publish Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 380],
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Saudi Cafe Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.callback_query.message.chat.id }}",
        "text": "=🔄 جاري إعادة توليد الفيديو بنمط مختلف وسكريبت جديد.. ثواني ومقطعك يوصلك! ⏳"
      },
      "id": "node_retry_msg",
      "name": "Send Regenerating Notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 520],
      "credentials": {
        "telegramApi": {
          "id": "telegram_bot_credentials",
          "name": "Saudi Cafe Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger (Photo + Caption)": {
      "main": [
        [
          {
            "node": "Router (Photo or Callback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Router (Photo or Callback)": {
      "main": [
        [
          {
            "node": "Download Telegram Photo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Approve Callback?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Telegram Photo": {
      "main": [
        [
          {
            "node": "Parse Caption & Style",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Caption & Style": {
      "main": [
        [
          {
            "node": "Generate Saudi Video (FFmpeg + EdgeTTS)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Saudi Video (FFmpeg + EdgeTTS)": {
      "main": [
        [
          {
            "node": "Send Video & Approval Buttons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Approve Callback?": {
      "main": [
        [
          {
            "node": "Send Publish Confirmation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Regenerating Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
